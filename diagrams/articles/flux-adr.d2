flux: Flux ADR — article_show {
  shape: sequence_diagram

  nav: Navigateur
  res: ArgumentResolver
  cm: ContentManager
  act: ShowAction
  rep: ShowResponder

  nav -> res: "GET /articles/{slug}"
  res -> cm: "résout {slug:article}"
  cm -> res: Article
  res -> act: __invoke(Article)
  act -> rep: (responder)(article)
  rep -> rep: getLastModifiedOrCreated()
  rep -> act: Response + Last-Modified
  act -> nav: 200 HTML
}
