{% set page = content_get('App\\Domain\\Page\\Model\\Page', 'home') %}

{% set pageTitle = page.title %}

{% extends 'base.html.twig' %}

{% block meta_title page.title %}

{% block meta %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <section class="section">
        <h1>Développement Symfony,<br>Formation et accompagnement</h1>
{#        {{ page.content|raw }}#}
        <p class="fs-4">
            Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet <a href="#">dolore</a> magna aliquam erat volutpat.
        </p>
    </section>

    {% for section in sections %}
        {{ include('pages/sections/' ~ section.type.value ~ '.html.twig', {
            section: section,
            page: page,
        }, with_context=false) }}
    {% endfor %}

{% endblock %}
