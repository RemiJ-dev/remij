<header
    class="container navbar navbar-expand-lg sticky-top"
    {{ stimulus_controller('toggle-class') }}
>
    <nav class="container-fluid">
        <a href="{{ path('page_home') }}" class="navbar-brand">
            <img
                src="{{ asset('images/logo/logo_inline.svg') }}"
                alt="{{ site.title }}"
                class="navbar-brand__logo navbar-brand__logo--light w-50"
            >
            <img
                src="{{ asset('images/logo/logo_inline-dark.svg') }}"
                alt="{{ site.title }}"
                class="navbar-brand__logo navbar-brand__logo--dark w-50"
            >
        </a>
        <button type="button"
                class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="{{ 'layout.header.toggle_navigation'|trans }}"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end position-relative" id="navbarNav">
            <ul class="navbar-nav navbar-nav--main">
                {% set route = app.request.attributes.get('_route') %}
                {% set activeMenuPosition = null %}

                {% for item in site.menu %}
                    {% set isActive = item.path is defined
                        and route == item.path
                        or route in item.children|default([])
                    %}

                    <li class="nav-item">
                        <a
                            href="{{ item.url ?? path(item.path, item.params|default({})) }}"
                            class="nav-link{% if isActive %} active{% endif %}"
                            {% if item.url is defined %}target="_blank"{% endif %}
                        >
                            {% if item.icon|default(false) %}
                                <i class="icon icon--{{ item.icon }}" aria-hidden="true"></i>
                            {% endif %}

                            <span>{{ item.label }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown" {{ stimulus_controller('theme') }}>
                    <button type="button"
                            class="btn btn-link nav-link px-0 px-lg-2 py-2 dropdown-toggle d-flex align-items-center"
                            aria-expanded="false"
                            data-bs-toggle="dropdown"
                            data-bs-display="static"
                            aria-label="{{ 'layout.header.theme.toggle'|trans }}"
                    >
                        <span class="ms-2">{{ 'layout.header.theme.toggle'|trans }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button type="button"
                                    class="dropdown-item d-flex align-items-center"
                                    data-theme-target="toggle"
                                    data-theme-value="light"
                                    data-action="click->theme#switch"
                            >
                                {{ 'layout.header.theme.light'|trans }}
                            </button>
                        </li>
                        <li>
                            <button type="button"
                                    class="dropdown-item d-flex align-items-center"
                                    data-theme-target="toggle"
                                    data-theme-value="dark"
                                    data-action="click->theme#switch"
                            >
                                {{ 'layout.header.theme.dark'|trans }}
                            </button>
                        </li>
                        <li>
                            <button type="button"
                                    class="dropdown-item d-flex align-items-center"
                                    data-theme-target="toggle"
                                    data-theme-value="auto"
                                    data-action="click->theme#switch"
                            >
                                {{ 'layout.header.theme.auto'|trans }}
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>
