{% set pageTitle = pageTitle|default('') %}

<!DOCTYPE html>
<html lang="{% block meta_locale app.request.locale %}">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block meta_title site.title %}</title>

        {% block meta %}
            <meta name="description" content="{% block meta_description site.description %}" />
            <link rel="canonical" href="{{ app.request.uri }}" />
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        {% endblock %}

        <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}" />
        <meta name="apple-mobile-web-app-title" content="RémiJ" />
        <link rel="manifest" href="{{ asset('site.webmanifest') }}" />

        {# FrankenPHP hot reload (dev only): the server var is only set when the `hot_reload` directive is active. #}
        {% set hotReloadUrl = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if hotReloadUrl %}
            <meta name="frankenphp-hot-reload:url" content="{{ hotReloadUrl }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        {# Umami analytics (prod only, so the dev server never reports traffic).
           Nginx proxies both the script and its collect endpoint under /stats/,
           so they share the site's own origin: no third-party request, nothing
           for tracker blocklists to match. The tracker derives its endpoint from
           the script's directory, so /stats/script.js posts to /stats/api/send —
           keep the two paths in sync (see snippets/umami-firstparty.conf). #}
        {% if app.environment == 'prod' %}
            <script defer src="/stats/script.js" data-website-id="0f2bea39-4a15-4503-b548-c3bec47f6981"></script>
        {% endif %}
    </head>
    <body>
        {% block header %}
            {{ include('layout/_header.html.twig') }}
        {% endblock %}

        <main class="container main">
            {{ include('layout/_breadcrumb.html.twig') }}

            {{ include('layout/_flashes.html.twig') }}

            {% block content '' %}
        </main>

        {% block footer %}
            {{ include('layout/_footer.html.twig') }}
        {% endblock %}
    </body>
</html>
