<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fr">

    <title>{{ site.title }}</title>
    <subtitle>{{ site.description }}</subtitle>
    <link href="{{ url('rss') }}" rel="self" type="application/atom+xml"/>
    <link href="{{ url('page_home') }}" rel="alternate" type="text/html"/>
    <id>{{ url('page_home') }}</id>
    <updated>{{ lastModified|date('Y-m-d\\TH:i:s\\Z') }}</updated>

    {% for entry in entries %}
        <entry>
            <title>{{ entry.title }}</title>
            <link href="{{ url(entry.routeName, entry.routeParams) }}" rel="alternate" type="text/html"/>
            <id>{{ url(entry.routeName, entry.routeParams) }}</id>
            <published>{{ entry.publishedAt|date('Y-m-d\\TH:i:s\\Z') }}</published>
            <updated>{{ entry.updated|date('Y-m-d\\TH:i:s\\Z') }}</updated>
            {% if entry.description %}
                <summary type="text">{{ entry.description }}</summary>
            {% endif %}
            {% for author in entry.authors %}
            <author>
                <name>{{ author }}</name>
            </author>
            {% endfor %}
            {% for tag in entry.tags %}
                <category term="{{ tag }}"/>
            {% endfor %}
        </entry>
    {% endfor %}
</feed>
